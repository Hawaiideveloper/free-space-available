# free-space-available configuration
# Copy to .env and customize

# ═══════════════════════════════════════════════════════════════════════════
# SCAN SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

# Default scan paths (comma-separated)
# macOS: ~/Documents/github,~
# Windows: C:\Users\%USERNAME%\Documents,C:\Dev
SCAN_PATHS=~/Documents/github,~

# Scan entire machine (overrides SCAN_PATHS)
# WARNING: Can take a long time on large disks
SCAN_ENTIRE_MACHINE=false

# Minimum file age to consider for cleanup (days)
# 0 = no minimum age
MIN_AGE_DAYS=0

# Minimum size to report (KB)
MIN_SIZE_KB=100

# ═══════════════════════════════════════════════════════════════════════════
# ARCHIVE SETTINGS (instead of permanent delete)
# ═══════════════════════════════════════════════════════════════════════════

# Enable archive mode - move files instead of deleting
ARCHIVE_MODE=false

# Archive directory (will be created if doesn't exist)
# macOS/Linux: /Volumes/ExternalDrive/cleanup-archive
# Windows: D:\cleanup-archive
ARCHIVE_DIR=~/.cleanup-archive

# Compress archives (creates .tar.gz on Unix, .zip on Windows)
ARCHIVE_COMPRESS=true

# Auto-delete archives older than N days (0 = never auto-delete)
ARCHIVE_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════
# AI INTEGRATION (corey-coder)
# ═══════════════════════════════════════════════════════════════════════════

# Corey-router endpoint
COREY_ENDPOINT=http://corey-router.corey-coder.svc.cluster.local:8081

# Model to use for AI queries
COREY_MODEL=corey-coder:latest

# Fallback model if primary unavailable
COREY_FALLBACK_MODEL=qwen3.8:latest

# Enable AI recommendations
AI_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════
# SAFETY SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

# Only allow deleting SAFE items (ignore CAUTION and REVIEW)
SAFE_MODE_ONLY=false

# Require confirmation before delete
REQUIRE_CONFIRMATION=true

# Dry run by default (preview only)
DRY_RUN_DEFAULT=false

# ═══════════════════════════════════════════════════════════════════════════
# PLATFORM-SPECIFIC PATHS
# ═══════════════════════════════════════════════════════════════════════════

# Additional paths to scan (platform-specific, comma-separated)
# These are added to the built-in cache locations
EXTRA_CACHE_PATHS=

# Paths to exclude from scanning (glob patterns, comma-separated)
EXCLUDE_PATHS=**/node_modules/**/node_modules,**/.git

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════

# Log file location (empty = no logging)
LOG_FILE=~/.cleanup-dev-caches.log

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
